{
  "name": "visual-desloppify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Get all the data, then focus it down.",
  "bin": {
    "vds": "src/cli.ts"
  },
  "scripts": {
    "map": "node src/cli.ts map",
    "extract": "node src/cli.ts extract",
    "invariants": "node src/cli.ts invariants",
    "focus": "node src/cli.ts focus",
    "agent": "node src/cli.ts agent",
    "view": "electron electron/main.cjs",
    "shot": "VDS_SHOT=${VDS_SHOT:-./out/view.png} electron electron/main.cjs",
    "smoke": "node src/test/smoke.ts",
    "typecheck": "tsc --noEmit",
    "gui": "vite build && electron electron/main.cjs",
    "gui:dev": "vite --host 127.0.0.1",
    "ui:build": "vite build",
    "test": "node src/test/smoke.ts ./out && node src/test/scene.ts ./out",
    "plan": "node src/cli.ts plan"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "vite": "^8.2.1"
  }
}
