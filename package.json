{
  "name": "visual-desloppify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Get all the data, then focus it down.",
  "bin": {
    "vds": "src/cli.ts"
  },
  "scripts": {
    "map": "node src/cli.ts map",
    "extract": "node src/cli.ts extract",
    "invariants": "node src/cli.ts invariants",
    "focus": "node src/cli.ts focus",
    "agent": "node src/cli.ts agent",
    "view": "electron electron/main.cjs",
    "shot": "VDS_SHOT=${VDS_SHOT:-./out/view.png} electron electron/main.cjs",
    "smoke": "node src/test/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "three": "^0.185.1",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "electron": "^43.4.0"
  }
}
