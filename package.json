{
  "name": "visual-desloppify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Get all the data, then focus it down.",
  "bin": {
    "vds": "engine/cli.ts"
  },
  "scripts": {
    "map": "node engine/cli.ts map",
    "extract": "node engine/cli.ts extract",
    "invariants": "node engine/cli.ts invariants",
    "focus": "node engine/cli.ts focus",
    "agent": "node engine/cli.ts agent",
    "view": "electron app/main/main.cjs",
    "shot": "VDS_SHOT=${VDS_SHOT:-./out/view.png} electron app/main/main.cjs",
    "smoke": "node engine/test/smoke.ts",
    "typecheck": "tsc -p engine --noEmit && tsc -p app/renderer --noEmit",
    "gui": "vite build && electron app/main/main.cjs",
    "gui:dev": "vite --host 127.0.0.1",
    "ui:build": "vite build",
    "test": "node engine/test/smoke.ts ./out && node engine/test/scene.ts ./out",
    "plan": "node engine/cli.ts plan",
    "check": "node engine/cli.ts check",
    "test:all": "node engine/cli.ts map . --out ./out --top 0 && node engine/test/smoke.ts ./out && node engine/test/scene.ts ./out && node engine/test/frontier.ts ./out && node engine/test/share.ts && node engine/test/budget.ts && node engine/test/check.ts",
    "adopt": "node engine/cli.ts adopt",
    "export": "node engine/cli.ts export",
    "import": "node engine/cli.ts import"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "vite": "^8.2.1"
  }
}
